{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "skipLibCheck": true, "verbatimModuleSyntax": true,
    "resolveJsonModule": true, "types": ["node"], "outDir": "dist"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
